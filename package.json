{
  "name": "class-cut",
  "productName": "Class Cut",
  "version": "0.3.0",
  "description": "Corta las clases grabadas con Rodecaster Video y genera XML para Premiere Pro y DaVinci Resolve",
  "main": "main.js",
  "author": "Daniel Gutiérrez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "maqueta": "node tools/maqueta.js --abrir",
    "test": "node tests/run.js",
    "build": "bash tools/build-pkg.sh",
    "publish": "bash tools/publish-release.sh"
  },
  "build": {
    "appId": "com.codigo.classcut",
    "productName": "Class Cut",
    "files": [
      "main.js",
      "preload.js",
      "dev-shot.js",
      "package.json",
      "version.json",
      "engine/**/*",
      "ipc/**/*",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Class Cut escucha la entrada de audio para medir el nivel y para escribir las notas de la clase mientras se graba.",
        "NSCameraUsageDescription": "Class Cut muestra en pantalla lo que está entrando por una cámara o por el Rodecaster Video, para ver qué se está filmando mientras se toman las notas. Ese video no se graba ni se guarda."
      },
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "bin/mac",
          "to": "bin",
          "filter": [
            "**/*",
            "!models/**",
            "!ollama-models/**"
          ]
        }
      ]
    },
    "pkg": {
      "artifactName": "ClassCut-${version}-arm64.${ext}",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
